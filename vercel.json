{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tractarimasinisibiu.ro" }],
      "destination": "https://www.tractarimasinisibiu.ro/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).(jpg|jpeg|png|webp|avif|svg|js|css|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}